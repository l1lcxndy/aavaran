{
  "manifest_version": 3,
  "name": "AAVARAN",
  "version": "1.0.0",
  "description": "On-device visual perception for browser agents. PII pixels are destroyed locally before any egress.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "panel/index.html",
    "default_title": "AAVARAN"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  }
}
