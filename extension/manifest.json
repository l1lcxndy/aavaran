{
  "manifest_version": 3,
  "name": "AAVARAN",
  "version": "0.1.0",
  "description": "Privacy-preserving on-device visual perception for browser agents",
  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AAVARAN Control Panel"
  },
  "options_page": "panel/index.html"
}
